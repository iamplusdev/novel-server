# 环境变量（复制为 .env 或导出到 shell / systemd / docker）
# 管理账号在首次打开 /admin 时创建；忘记密码用恢复码或 python reset_auth.py

# 浏览器访问入口（前端端口）
PUBLIC_BASE_URL=http://127.0.0.1:7311
HOST=0.0.0.0
# 后端 API 端口
PORT=7312
# 前端静态/反代端口
FRONTEND_PORT=7311
NOVELS_DIR=./novels
DATABASE_PATH=./data/novels.db
COVERS_DIR=./covers
# HTTPS / 反向代理部署时设为 1，会话 Cookie 带 Secure
COOKIE_SECURE=0
# 公网必备：读接口密钥（Legado 以 X-Api-Key 头携带，随书源 JSON 自动注入）
# 未设置时读接口只认管理会话，匿名/仅持 Key 的请求一律 401
READ_API_KEY=
# 反代可信 Host 白名单（逗号分隔，如 novel.example.com,192.168.1.100）
# 设置后启用 Host 校验并允许据此推导对外基址；留空则基址固定用 PUBLIC_BASE_URL
TRUSTED_HOSTS=

# 刮削：默认方式为 api（纯 HTTP）；auto=API 优先、失败用 Chrome 兜底
# 1=允许 auto 在 API 失败后用 Chrome 兜底（默认开启）；0=完全禁用浏览器通道
SCRAPER_BROWSER_FALLBACK=1
CDP_URL=http://127.0.0.1:16002
CDP_READY_WAIT=20

# 刮削限速 / 降频（防风控）
# 同一域名两次请求的最小间隔（秒）；0=关闭（默认较保守，降低被风控概率）
SCRAPER_HOST_MIN_INTERVAL=2.0
# 间隔随机抖动上限（秒）
SCRAPER_HOST_JITTER_MAX=0.6
# 被限流/风控(429/403/503)时的退避重试：最大次数 / 基数秒 / 是否尊重 Retry-After
SCRAPER_RETRY_MAX=3
SCRAPER_RETRY_BASE=2
SCRAPER_RESPECT_RETRY_AFTER=1
# 搜索结果缓存 TTL（秒）；0=关闭
SCRAPER_SEARCH_CACHE_TTL=1800
# 高置信（分数达标且搜索字段齐全）时跳过详情请求：1=开 0=关
SCRAPER_SKIP_DETAIL=1
SCRAPER_SKIP_DETAIL_SCORE=0.95
# 单本 TXT 导入大小上限（字节）；0=不限制。超限文件跳过并计入导入失败
MAX_TXT_BYTES=0
# 封面下载：missing=本地已有封面则跳过 / replace=总是替换 / skip=从不下载
SCRAPER_COVER=missing
# 单源连续被拦 N 次后该源冷却（秒）；冷却期间 source=all 跳过改试下一源
SCRAPER_SOURCE_BREAK_AT=2
SCRAPER_SOURCE_COOLDOWN_SECONDS=180
# 批量番茄：无书号时用必应反查书名（1=开 0=关）；MAX 为整批最多反查次数，0=不限
SCRAPER_FANQIE_BING=1
SCRAPER_FANQIE_BING_MAX=0
